<% layout('/layouts/boilerplate') -%>

<div class="row">
    <h1 class="col-6 offset-4">Log In</h1>
    <div class="col-6 offset-4">
        <form action="/login" method="POST" novalidate class="needs-validation">
            <div class="mb-3">
                    <lable for="username" class="form-label">Username</lable>
                    <input type="text" name="username" id="username" class="form-control" required>
                    <div class="invalid-feedback">Please provide a username.</div>
            </div>
            <div class="mb-3">
                    <lable for="password" class="form-label">Password</lable>
                    <input type="password" name="password" id="password" class="form-control" required>
                    <div class="invalid-feedback">Please provide a password.</div>
            </div>
            <button class="btn btn-success mb-3" type="submit">Log In</button>
        </form>
    </div>
</div>