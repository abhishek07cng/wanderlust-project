<% layout("/layouts/boilerplate") %>

<h2>All Listings (Admin)</h2>

<table class="table">
  <thead>
    <tr>
      <th>Title</th>
      <th>Owner</th>
      <th>Price</th>
      <th>Action</th>
    </tr>
  </thead>

  <tbody>
    <% for (let listing of listings) { %>
      <tr>
        <td><%= listing.title %></td>
        <td><%= listing.owner.username %></td>
        <td>₹ <%= listing.price %></td>
        <td>
          <form action="/admin/listings/<%= listing._id %>?_method=DELETE" method="POST">
            <button class="btn btn-danger btn-sm">Delete</button>
          </form>
        </td>
      </tr>
    <% } %>
  </tbody>
</table>
