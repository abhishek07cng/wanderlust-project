<% layout("/layouts/boilerplate") %>

<h1>Manage Users</h1>

<table class="table mt-4">
  <thead>
    <tr>
      <th>Username</th>
      <th>Email</th>
      <th>Role</th>
    </tr>
  </thead>
  <tbody>
    <% for (let user of users) { %>
      <tr>
        <td><%= user.username %></td>
        <td><%= user.email %></td>
        <td><%= user.role %></td>
      </tr>
    <% } %>
  </tbody>
</table>
